{
  "openapi": "3.1.0",
  "info": {
    "title": "Brief shared workspace interface",
    "version": "1.0.0",
    "description": "Durable workspace-owned corpora and results. Timestamps are Unix milliseconds. Hosted human sessions require Sites dispatch authentication and Origin on writes; integration servers use a scoped key and may additionally need a hosting bypass credential. Never send unverified user identity headers to an exposed server. The bearer scheme models server integrations. Human-only endpoints use an existing browser session through Sites dispatch, not an integration key; this external hosting session is not specified by this contract."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "integrationBearer": []
    }
  ],
  "paths": {
    "/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "summary": "listWorkspaces",
        "description": "Signed-in human; only their memberships.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Workspace"
                      }
                    }
                  },
                  "required": ["items"]
                }
              }
            }
          },
          "default": {
            "description": "Structured application error (400, 401, 403, 404, 409, 413, 415, 500). The hosting gate may return an authentication redirect before reaching the application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWorkspace",
        "summary": "createWorkspace",
        "description": "Signed-in human becomes owner.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "default": {
            "description": "Structured application error (400, 401, 403, 404, 409, 413, 415, 500). The hosting gate may return an authentication redirect before reaching the application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": ["name"]
              }
            }
          }
        }
      }
    },
