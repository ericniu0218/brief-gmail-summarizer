    "/workspaces/{workspaceId}/capture": {
      "post": {
        "operationId": "captureGmailCorpus",
        "summary": "captureGmailCorpus",
        "description": "Human with write permission. Without publish returns preview; publish=true requires previewHash and Idempotency-Key. Changed snapshot returns 409.",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Required when publish=true."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "preview": {
                          "$ref": "#/components/schemas/ArtifactInput"
                        },
                        "previewHash": {
                          "type": "string"
                        }
                      },
                      "required": ["preview", "previewHash"]
                    },
                    {
                      "$ref": "#/components/schemas/Published"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured application error (400, 401, 403, 404, 409, 413, 415, 500). The hosting gate may return an authentication redirect before reaching the application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Published corpus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Published"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "const": "default"
                  },
                  "messageIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 60,
                    "items": {
                      "type": "string"
                    }
                  },
                  "title": {
                    "type": "string"
                  },
                  "publish": {
                    "type": "boolean",
                    "default": false
                  },
                  "previewHash": {
                    "type": "string"
                  }
                },
                "required": ["accountId", "messageIds", "title"]
              }
            }
          }
        }
      }
    },
