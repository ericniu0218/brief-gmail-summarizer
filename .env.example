# Server-only runtime configuration. Never put provider keys in browser code.
APP_URL=https://gmail-hub-brief.lukeli1708.chatgpt.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Required for summaries and suggested replies. Without it the reply buttons stay disabled.
GEMINI_API_KEY=
# Optional. Defaults to a current low-cost model with free-tier access.
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared only with the protected scheduler that invokes /api/agent.
AGENT_CRON_SECRET=
# Optional additional trusted one-click unsubscribe endpoint domains, comma-separated.
UNSUBSCRIBE_ALLOWED_HOSTS=
# Optional. Emails one person may send per rolling 24 hours (default 100). Drafts are not counted.
SEND_DAILY_LIMIT=

# At least 32 random characters, shared only with your authenticated identity ingress.
# The ingress must set x-brief-identity-secret after verifying the session and stripping client copies.
IDENTITY_PROXY_SECRET=
